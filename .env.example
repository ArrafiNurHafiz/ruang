# ==============================================================================
# TAMENG - RUANG AMAN KELUARGA & SEKOLAH
# Environment Variables Configuration Guide (Neon / Vercel Postgres Native)
# 100% Free Forever, No Trial, Zero Auto-Pause
# ==============================================================================

# 1. API URL
# Di Vercel: Kosongkan agar frontend otomatis memanggil Vercel Serverless Function (/api)
# Di Local Dev: VITE_API_URL=http://localhost:3001/api (menggunakan backend Express server.cjs)
VITE_API_URL=

# 2. Vercel Postgres / Neon Serverless PostgreSQL (100% Free Forever)
# Di Vercel Dashboard:
# Buka Proyek -> Tab "Storage" -> Klik "Create Database" -> Pilih "Postgres" (Neon).
# Vercel akan OTOMATIS mengisi variabel POSTGRES_URL di bawah ini ke proyek Anda.
# Tidak perlu kartu kredit, tidak ada masa kedaluwarsa trial, dan tidak pernah auto-pause.
POSTGRES_URL=postgres://default:password@ep-sample-pooler.us-east-1.aws.neon.tech/verceldb?sslmode=require
DATABASE_URL=postgres://default:password@ep-sample-pooler.us-east-1.aws.neon.tech/verceldb?sslmode=require

# 3. Security
JWT_SECRET=TAMENG_PPKSP_SECURE_AUTH_SIGNING_KEY_2026
